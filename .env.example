# Строка подключения к Postgres (Neon через Vercel Marketplace).
# Локально: скопируйте в .env или получите через `vercel env pull`.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Токен Vercel Blob (создаётся при подключении Blob Store к проекту).
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
