# Строка подключения к Postgres (Neon через Vercel Marketplace).
# Локально: скопируйте в .env или получите через `vercel env pull`.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Токен Vercel Blob (создаётся при подключении Blob Store к проекту).
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- Docker (docker-compose.yml) ---
# Пароль докерного Postgres (обязателен для docker compose up)
# POSTGRES_PASSWORD="придумайте-пароль"
# Домен для caddy на ВМ (профиль prod)
# SITE_DOMAIN="bug-repor.grigogo.ru"

# Защита сайта паролем: пользователи в формате "логин:пароль,логин2:пароль2"
# (логины латиницей, без запятых и двоеточий в паролях).
# Если переменная не задана — сайт открыт без входа (локальный режим).
# AUTH_USERS="grigogo:secret1,tester:secret2"
