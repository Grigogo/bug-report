generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

enum TaskStatus {
  NEW
  IN_PROGRESS
  REVIEW
  DONE
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String
  steps       String?
  status      TaskStatus   @default(NEW)
  createdAt   DateTime     @default(now())
  completedAt DateTime?
  // Момент последней правки полей задачи (статусные переходы не считаются)
  editedAt    DateTime?
  screenshots Screenshot[]
  comments    Comment[]
  tags        Tag[]
  timeEntries TimeEntry[]
}

model Report {
  id        String   @id @default(cuid())
  title     String?
  createdAt DateTime @default(now())
  // Снимок данных на момент построения: { rows: [...], totalSeconds }
  data      Json
}

model TimeEntry {
  id        String    @id @default(cuid())
  startedAt DateTime  @default(now())
  stoppedAt DateTime?
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  color String @default("zinc")
  tasks Task[]
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  isNew     Boolean  @default(true)
  createdAt DateTime @default(now())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Screenshot {
  id     String @id @default(cuid())
  url    String
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
}
